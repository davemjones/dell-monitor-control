{
  "default-configuration": "Release",
  "configurations": [
    { "name": "Debug", "file": "Config/MonitorControl.xcconfig" },
    { "name": "Release", "file": "Config/MonitorControl.xcconfig" },
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    { "kind": "folder", "path": "App", "target-membership": [ "MonitorControl" ] },
    { "kind": "folder", "path": "Sources/MonitorControlCore", "target-membership": [ "MonitorControlCore" ] },
    {
      "kind": "group",
      "path": "Config",
      "children": [
        { "path": "MonitorControl.xcconfig" },
        { "path": "Signing.local.xcconfig.example" },
      ],
    }, {
      "kind": "group",
      "name": "Helpers",
      "children": [
        { "path": "<PROJECT>/../target/release/monitorctl", "target-membership": [ { "build-phase": "MonitorControl/copy/Bundle monitorctl", "code-sign-on-copy": true } ] },
      ],
    }, {
      "kind": "folder",
      "path": "Controls",
      "target-membership": [
        "ControlsExtension",
      ],
      "membership-exceptions": [
        {
          "target": "ControlsExtension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "/System/Library/Frameworks/WidgetKit.framework", "target-membership": [ "ControlsExtension/frameworks" ] },
        { "path": "/System/Library/Frameworks/SwiftUI.framework", "target-membership": [ "ControlsExtension/frameworks" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Monitor Control.app", "id": "4D4300020000000000000001", "type": "wrapper.application", "index": false },
        {
          "path": "<PRODUCTS>/MonitorControlCore.framework",
          "id": "4D4300020000000000000002",
          "type": "wrapper.framework",
          "index": false,
          "target-membership": [
            "MonitorControl/frameworks",
            { "build-phase": "MonitorControl/copy/Embed Frameworks", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" },
            "ControlsExtension/frameworks",
          ],
        },
        { "path": "<PRODUCTS>/ControlsExtension.appex", "id": "DC07031530B385DC00143F75", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "MonitorControl/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "MonitorControl",
      "id": "4D4300010000000000000001",
      "product": "Products/Monitor Control.app",
      "product-type": "application",
      "dependencies": [
        "MonitorControlCore",
        "ControlsExtension",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        }, {
          "kind": "copy",
          "name": "Bundle monitorctl",
          "bundle-base-path": "contents-directory",
          "relative-path": "Helpers",
        }, {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_STYLE": "Automatic",
        "ENABLE_APP_SANDBOX": "NO",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_CFBundleDisplayName": "Monitor Control",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.utilities",
        "INFOPLIST_KEY_LSUIElement": "YES",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/../Frameworks",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.davemjones.monitor-control",
        "PRODUCT_NAME": "Monitor Control",
      },
    }, {
      "name": "MonitorControlCore",
      "id": "4D4300010000000000000002",
      "product": "Products/MonitorControlCore.framework",
      "product-type": "framework",
      "build-phases": [
        "headers",
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "CODE_SIGN_STYLE": "Automatic",
        "DYLIB_COMPATIBILITY_VERSION": "1",
        "DYLIB_CURRENT_VERSION": "1",
        "DYLIB_INSTALL_NAME_BASE": "@rpath",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INSTALL_PATH": "$(LOCAL_LIBRARY_DIR)/Frameworks",
        "LD_RUNPATH_SEARCH_PATHS": [
          "@executable_path/../Frameworks",
          "@loader_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.davemjones.monitor-control.core",
        "PRODUCT_NAME": "MonitorControlCore",
        "SKIP_INSTALL": "YES",
        "SWIFT_INSTALL_OBJC_HEADER": "NO",
        "VERSIONING_SYSTEM": "apple-generic",
      },
    }, {
      "name": "ControlsExtension",
      "id": "DC07031430B385DC00143F75",
      "product": "Products/ControlsExtension.appex",
      "product-type": "app-extension",
      "dependencies": [
        "MonitorControlCore",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "ASSETCATALOG_COMPILER_WIDGET_BACKGROUND_COLOR_NAME": "WidgetBackground",
        "CODE_SIGN_STYLE": "Automatic",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Controls/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Monitor Control",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
          "@executable_path/../../../../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.davemjones.monitor-control.controls",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SKIP_INSTALL": "YES",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "COPY_PHASE_STRIP": "NO",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "MACOSX_DEPLOYMENT_TARGET": "27.0",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SDKROOT": "macosx",
    "SUPPORTED_PLATFORMS": "macosx",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_VERSION": "6.0",
  },
  "last-upgrade": "27.2",
  "last-swift-update": "27.2",
}
